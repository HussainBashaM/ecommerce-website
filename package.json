{
  "name": "ecommerce-website",
  "version": "1.0.0",
  "description": "Full-stack e-commerce website",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=frontend\" \"npm run dev --workspace=backend\"",
    "build": "npm run build --workspaces",
    "install-all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
